## External network (should match db-server/.env NETWORK_NAME)
NETWORK_NAME=iam-coe-local-net

## MySQL connection (container name and port from db-server)
MYSQL_CONTAINER_NAME=mysql_db
MYSQL_PORT=3306

## phpMyAdmin settings
PMA_PORT=8086
PMA_CONTAINER_NAME=phpmyadmin


## Alpha Configuration
DB_HOST=mysql_db
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_pass
