## DB selection
DB_TYPE=mysql

## Network (docker network must be created as external)
NETWORK_NAME=iam-coe-local-net

## Named volume for DB data (driver: local)
DB_DATA_VOLUME=db_data

# Host data directory (project-relative). Default is ./data inside `db-server`.
# You can change to an absolute path for your OS if desired (e.g., /var/lib/mysql on Ubuntu).
HOST_DATA_DIR=./data

## MySQL settings
MYSQL_IMAGE=mysql
MYSQL_VERSION=8.0
MYSQL_CONTAINER_NAME=mysql_db
MYSQL_ROOT_PASSWORD=secret_root_password
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_pass
MYSQL_PORT=3306

## Postgres settings
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=15
POSTGRES_CONTAINER_NAME=postgres_db
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_pass
POSTGRES_PORT=5432
