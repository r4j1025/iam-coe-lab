## External network name (match db-server/.env)
NETWORK_NAME=iam-coe-local-net

## DB defaults (connects to db-server/mysql)
DB_HOST=mysql_db
DB_PORT=3306
DB_NAME=identityiq
DB_USER=app_user
DB_PASSWORD=app_pass
DB_ROOT_USER=root
DB_ROOT_PASSWORD=I@mR00t

## SailPoint image
SAILPOINT_IMAGE=sailpoint-app
SAILPOINT_VERSION=1.0
SAILPOINT_CONTAINER_NAME=sailpoint
SAILPOINT_PORT=8080
SPTARGET=sandbox

## Build control
# If true, start script will attempt to build from code/ (SSB structure)
BUILD_FROM_CODE=true

# WAR naming
# Base name for the IdentityIQ WAR (default identityiq). The final file used when building
# will be: ${WAR_BASE}${WAR_ENV:+-${WAR_ENV}}.war
# Examples:
#  - default: identityiq.war
#  - dev: identityiq-dev.war  (set WAR_ENV=dev)
#  - uat: identityiq-uat.war  (set WAR_ENV=uat)
WAR_BASE=identityiq
WAR_ENV=
