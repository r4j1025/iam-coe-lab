        </Field>
        <Field displayName="con_prov_policy_ad_password" helpKey="help_con_prov_policy_ad_password" name="password" section="User Details" type="secret">
          <Script>
            <Source><![CDATA[import sailpoint.object.PasswordPolicy;
              import sailpoint.api.PasswordGenerator;

              String policyName = "Alpha-ActiveDirectory-PasswordPolicy";
              PasswordPolicy policy = context.getObjectByName(PasswordPolicy.class, policyName);
              String password = new PasswordGenerator(context).generatePassword(policy);

              return password;]]></Source>
          </Script>
        </Field>
        <Field displayName="con_prov_policy_ad_pwdLastSet" helpKey="help_con_prov_policy_ad_pwdLastSet" name="pwdLastSet" section="User Details" type="boolean" value="true"/>
        <Field displayName="con_prov_policy_ad_IIQDisabled" helpKey="help_con_prov_policy_ad_IIQDisabled" name="IIQDisabled" section="User Details" type="boolean" value="false"/>
        <Field displayName="Department" name="department" type="string">
          <Script>
            <Source><![CDATA[return identity.getAttribute("department");]]></Source>
          </Script>
        </Field>
        <Field displayName="Employee Number" name="employeeNumber" type="string">
          <Script>
            <Source><![CDATA[return identity.getAttribute("employeeId");]]></Source>
          </Script>
        </Field>
        <Field displayName="Manager" name="manager" type="string">
          <Script>
            <Source><![CDATA[import sailpoint.tools.Util;
              import java.util.*;
              import sailpoint.object.Identity;
              import sailpoint.object.Application;
              import sailpoint.api.IdentityService;
              import sailpoint.object.Link;

              IdentityService identityService = new IdentityService(context);
              Application application = context.getObjectByName(Application.class, "Alpha - Active Directory");
              Identity manager = identity.getManager(); 
              String dn=null;

              if(null != manager && null != application)
              {
              List links = identityService.getLinks(manager,application);;
              if(null != links)
              {
              for(Link link : links)
              {
              dn=link.getAttribute("distinguishedName");
              //TODO: check primary AD account of manager and get DN
              }
              }

              }   

              return dn;]]></Source>
          </Script>
        </Field>
        <Field displayName="Display Name" name="displayName" type="string">
          <Script>
            <Source><![CDATA[return identity.getFirstname() +" "+ identity.getLastname();]]></Source>
          </Script>
        </Field>
        <Field displayName="City" name="l" type="string">
          <Script>
            <Source><![CDATA[return identity.getAttribute("city");]]></Source>
          </Script>
        </Field>
        <Field displayName="extensionName" name="extensionName" type="string">
          <Script>
            <Source><![CDATA[import sailpoint.object.Identity;
              import sailpoint.object.Link;
              import sailpoint.api.SailPointContext;
              import sailpoint.api.IdentityService;

              boolean createPrivilegeAccount = false;
              if(null != context.getProperty("createPrivilegeAccount"))
              {
              createPrivilegeAccount = Boolean.parseBoolean(context.getProperty("createPrivilegeAccount"));
              log.debug("createPrivilegeAccount"+createPrivilegeAccount );
              }

              if(createPrivilegeAccount)
              {
              return "privilegedAccount";
              }

              return "primaryAccount";]]></Source>
          </Script>
        </Field>
